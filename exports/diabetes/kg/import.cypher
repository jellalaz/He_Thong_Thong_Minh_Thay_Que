UNWIND [
{source:"HbA1c",relation:"phản ánh",target:"đường huyết trung bình",document:"a1c",evidence:"HbA1c phản ánh đường huyết trung bình khoảng ba tháng. Theo NIDDK, bảng sàng lọc cho người không mang thai: dưới 5,7%; tiền đái tháo đường 5,7–6,4%; ngưỡng đái tháo đường từ 6,5%. Thường cần xét nghiệm xác nhận. Mục tiêu điều trị của người đã mắc bệnh khác ngưỡng chẩn đoán; thai kỳ và bệnh máu có thể ảnh hưởng kết quả.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",source_page:null,source_file:null,source_sha256:null},
{source:"Thai kỳ / bệnh máu",relation:"có thể ảnh hưởng",target:"HbA1c",document:"a1c",evidence:"HbA1c phản ánh đường huyết trung bình khoảng ba tháng. Theo NIDDK, bảng sàng lọc cho người không mang thai: dưới 5,7%; tiền đái tháo đường 5,7–6,4%; ngưỡng đái tháo đường từ 6,5%. Thường cần xét nghiệm xác nhận. Mục tiêu điều trị của người đã mắc bệnh khác ngưỡng chẩn đoán; thai kỳ và bệnh máu có thể ảnh hưởng kết quả.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",source_page:null,source_file:null,source_sha256:null},
{source:"Kế hoạch tập",relation:"phụ thuộc",target:"thể trạng",document:"activity",evidence:"Mục tiêu tham khảo cho người lớn là ít nhất 150 phút vận động mức vừa mỗi tuần. Có thể bắt đầu bằng các buổi ngắn rồi tăng dần theo khả năng. Nếu có biến chứng hoặc dùng thuốc dễ gây hạ đường huyết, hãy trao đổi kế hoạch tập với nhân viên y tế.",source_url:"https://www.who.int/news-room/fact-sheets/detail/diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Vận động",relation:"hỗ trợ",target:"quản lý đường huyết",document:"activity",evidence:"Mục tiêu tham khảo cho người lớn là ít nhất 150 phút vận động mức vừa mỗi tuần. Có thể bắt đầu bằng các buổi ngắn rồi tăng dần theo khả năng. Nếu có biến chứng hoặc dùng thuốc dễ gây hạ đường huyết, hãy trao đổi kế hoạch tập với nhân viên y tế.",source_url:"https://www.who.int/news-room/fact-sheets/detail/diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Vận động",relation:"có thể bắt đầu bằng",target:"đi bộ ngắn",document:"activity_plan",evidence:"CDC gợi ý bắt đầu bằng mục tiêu nhỏ, chẳng hạn đi bộ khoảng 10 phút sau bữa tối, rồi tăng dần theo sức. Mục tiêu chung được nêu là ít nhất 150 phút vận động mức vừa mỗi tuần. Người có bệnh nền hoặc đang dùng thuốc làm hạ đường huyết nên hỏi nhóm chăm sóc về hoạt động phù hợp và cách theo dõi khi vận động.",source_url:"https://www.cdc.gov/diabetes/living-with/physical-activity.html",source_page:null,source_file:null,source_sha256:null},
{source:"Vận động",relation:"cần phù hợp",target:"tình trạng cá nhân",document:"activity_plan",evidence:"CDC gợi ý bắt đầu bằng mục tiêu nhỏ, chẳng hạn đi bộ khoảng 10 phút sau bữa tối, rồi tăng dần theo sức. Mục tiêu chung được nêu là ít nhất 150 phút vận động mức vừa mỗi tuần. Người có bệnh nền hoặc đang dùng thuốc làm hạ đường huyết nên hỏi nhóm chăm sóc về hoạt động phù hợp và cách theo dõi khi vận động.",source_url:"https://www.cdc.gov/diabetes/living-with/physical-activity.html",source_page:null,source_file:null,source_sha256:null},
{source:"Rượu bia khi dùng insulin",relation:"có thể gây",target:"hạ đường huyết",document:"alcohol",evidence:"Rượu bia có thể làm hạ đường huyết ở người dùng insulin hoặc một số thuốc tiểu đường. NIDDK khuyên trao đổi thói quen uống với nhóm chăm sóc, hạn chế lượng cồn và chú ý theo dõi đường huyết. Không có lượng uống an toàn chung để chatbot tự chỉ định cho mọi người.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Thói quen uống rượu bia",relation:"cần trao đổi với",target:"nhóm chăm sóc",document:"alcohol",evidence:"Rượu bia có thể làm hạ đường huyết ở người dùng insulin hoặc một số thuốc tiểu đường. NIDDK khuyên trao đổi thói quen uống với nhóm chăm sóc, hạn chế lượng cồn và chú ý theo dõi đường huyết. Không có lượng uống an toàn chung để chatbot tự chỉ định cho mọi người.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Huyết áp",relation:"gồm",target:"tâm thu / tâm trương",document:"bloodpressure",evidence:"Số trên là tâm thu, số dưới là tâm trương. Hãy gửi cả hai số và đơn vị, ví dụ 120/80 mmHg. Một lần đo chưa xác lập chẩn đoán; ghi lại số đo và trao đổi với cơ sở y tế.",source_url:"https://www.heart.org/en/health-topics/high-blood-pressure/understanding-blood-pressure-readings",source_page:null,source_file:null,source_sha256:null},
{source:"Phân loại",relation:"cần",target:"số đo và bối cảnh",document:"bloodpressure",evidence:"Số trên là tâm thu, số dưới là tâm trương. Hãy gửi cả hai số và đơn vị, ví dụ 120/80 mmHg. Một lần đo chưa xác lập chẩn đoán; ghi lại số đo và trao đổi với cơ sở y tế.",source_url:"https://www.heart.org/en/health-topics/high-blood-pressure/understanding-blood-pressure-readings",source_page:null,source_file:null,source_sha256:null},
{source:"Carbohydrate",relation:"ảnh hưởng",target:"đường huyết",document:"carb",evidence:"Không cần tự bỏ toàn bộ tinh bột. Chú ý khẩu phần, phân bố bữa ăn đều và kết hợp đạm, rau. Ưu tiên thực phẩm ít chế biến. Lượng carbohydrate phù hợp cần xem cùng thuốc, mức hoạt động và chỉ số sau bữa ăn.",source_url:"https://www.cdc.gov/diabetes/healthy-eating/diabetes-meal-planning.html",source_page:null,source_file:null,source_sha256:null},
{source:"Khẩu phần",relation:"cần điều chỉnh theo",target:"nhu cầu cá nhân",document:"carb",evidence:"Không cần tự bỏ toàn bộ tinh bột. Chú ý khẩu phần, phân bố bữa ăn đều và kết hợp đạm, rau. Ưu tiên thực phẩm ít chế biến. Lượng carbohydrate phù hợp cần xem cùng thuốc, mức hoạt động và chỉ số sau bữa ăn.",source_url:"https://www.cdc.gov/diabetes/healthy-eating/diabetes-meal-planning.html",source_page:null,source_file:null,source_sha256:null},
{source:"Buổi khám",relation:"cần làm rõ",target:"mục tiêu / lịch đo / lịch tái khám",document:"care_questions",evidence:"Có thể chuẩn bị: phiếu xét nghiệm trước đây; nhật ký đường huyết kèm thời điểm và triệu chứng; danh sách thuốc đang dùng. Những câu nên hỏi là mục tiêu riêng của mình, lịch đo, cách xử lý khi chỉ số quá thấp hoặc quá cao, thuốc dùng ra sao và khi nào tái khám. Ghi các câu hỏi trước buổi hẹn giúp đỡ quên thông tin.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Chuẩn bị đi khám",relation:"gồm",target:"phiếu xét nghiệm / nhật ký / danh sách thuốc",document:"care_questions",evidence:"Có thể chuẩn bị: phiếu xét nghiệm trước đây; nhật ký đường huyết kèm thời điểm và triệu chứng; danh sách thuốc đang dùng. Những câu nên hỏi là mục tiêu riêng của mình, lịch đo, cách xử lý khi chỉ số quá thấp hoặc quá cao, thuốc dùng ra sao và khi nào tái khám. Ghi các câu hỏi trước buổi hẹn giúp đỡ quên thông tin.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Mô hình phân loại",relation:"học từ",target:"nhãn tổng hợp High / Moderate / Low",document:"classification_scope",evidence:"High, Moderate và Low là các nhãn của bộ dữ liệu tổng hợp. Mô hình phân loại chỉ tái hiện nhãn trong bộ dữ liệu này; kết quả không phải chẩn đoán hoặc xác suất mắc bệnh của một người. Đánh giá ngoài mẫu và giới hạn của từng lớp được trình bày trong bảng thực nghiệm.",source_url:"https://www.kaggle.com/datasets/mobeenfatimah/diabetes-risk-prediction-dataset-50k-patients",source_page:null,source_file:null,source_sha256:null},
{source:"Nhãn tổng hợp",relation:"không phải",target:"chẩn đoán cá nhân",document:"classification_scope",evidence:"High, Moderate và Low là các nhãn của bộ dữ liệu tổng hợp. Mô hình phân loại chỉ tái hiện nhãn trong bộ dữ liệu này; kết quả không phải chẩn đoán hoặc xác suất mắc bệnh của một người. Đánh giá ngoài mẫu và giới hạn của từng lớp được trình bày trong bảng thực nghiệm.",source_url:"https://www.kaggle.com/datasets/mobeenfatimah/diabetes-risk-prediction-dataset-50k-patients",source_page:null,source_file:null,source_sha256:null},
{source:"Theo dõi bệnh",relation:"bao gồm",target:"đường huyết / huyết áp / cholesterol",document:"complications",evidence:"Đường huyết cao kéo dài có thể ảnh hưởng tim, thận, bàn chân, mắt và thần kinh. Theo dõi đường huyết cùng huyết áp và cholesterol giúp giảm nguy cơ biến chứng. Không có triệu chứng rõ không có nghĩa là không cần theo dõi; lịch kiểm tra cần thống nhất với nhóm chăm sóc.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Đường huyết cao kéo dài",relation:"có thể ảnh hưởng",target:"tim / thận / mắt / thần kinh",document:"complications",evidence:"Đường huyết cao kéo dài có thể ảnh hưởng tim, thận, bàn chân, mắt và thần kinh. Theo dõi đường huyết cùng huyết áp và cholesterol giúp giảm nguy cơ biến chứng. Không có triệu chứng rõ không có nghĩa là không cần theo dõi; lịch kiểm tra cần thống nhất với nhóm chăm sóc.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Mã giới tính nghiên cứu",relation:"không tự dùng để",target:"chọn ngưỡng HDL",document:"demographics",evidence:"Tuổi và mã giới tính là biến đầu vào nghiên cứu, không phải kết quả chẩn đoán. Mã 1/2 không được chatbot tự diễn giải thành giới để áp ngưỡng HDL; cần thông tin do người dùng xác nhận. Trẻ em và thai kỳ có cách đánh giá riêng.",source_url:"https://scikit-learn.org/stable/modules/generated/sklearn.datasets.load_diabetes.html",source_page:null,source_file:null,source_sha256:null},
{source:"Chăm sóc tiểu đường hằng ngày",relation:"có thể tạo",target:"áp lực và lo lắng",document:"diabetes_distress",evidence:"Theo dõi bệnh hằng ngày có thể tạo áp lực và lo lắng. Có thể bắt đầu từ một mục tiêu nhỏ, nhờ người thân hỗ trợ, vận động nhẹ hoặc dành thời gian thư giãn. Nếu buồn bã, lo âu kéo dài hoặc ảnh hưởng sinh hoạt, hãy trao đổi với nhóm chăm sóc để được giúp đỡ. Không quy mọi triệu chứng cơ thể cho căng thẳng.",source_url:"https://www.cdc.gov/diabetes/living-with/mental-health.html",source_page:null,source_file:null,source_sha256:null},
{source:"Lo âu kéo dài",relation:"cần trao đổi với",target:"nhóm chăm sóc",document:"diabetes_distress",evidence:"Theo dõi bệnh hằng ngày có thể tạo áp lực và lo lắng. Có thể bắt đầu từ một mục tiêu nhỏ, nhờ người thân hỗ trợ, vận động nhẹ hoặc dành thời gian thư giãn. Nếu buồn bã, lo âu kéo dài hoặc ảnh hưởng sinh hoạt, hãy trao đổi với nhóm chăm sóc để được giúp đỡ. Không quy mọi triệu chứng cơ thể cho căng thẳng.",source_url:"https://www.cdc.gov/diabetes/living-with/mental-health.html",source_page:null,source_file:null,source_sha256:null},
{source:"Không thêm đường",relation:"không đồng nghĩa với",target:"không có carbohydrate",document:"drinks",evidence:"NIDDK gợi ý chọn nước lọc và đồ uống ít hoặc không thêm đường như trà hay cà phê không đường. Sữa và đồ uống có hương vị vẫn cần xem thành phần và lượng carbohydrate; nhãn không thêm đường không có nghĩa là không có carbohydrate. Hạn chế đồ uống có đường; lựa chọn và phần uống cần phù hợp kế hoạch ăn của người bệnh.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Lựa chọn đồ uống",relation:"ưu tiên",target:"nước lọc / ít hoặc không thêm đường",document:"drinks",evidence:"NIDDK gợi ý chọn nước lọc và đồ uống ít hoặc không thêm đường như trà hay cà phê không đường. Sữa và đồ uống có hương vị vẫn cần xem thành phần và lượng carbohydrate; nhãn không thêm đường không có nghĩa là không có carbohydrate. Hạn chế đồ uống có đường; lựa chọn và phần uống cần phù hợp kế hoạch ăn của người bệnh.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Chăm sóc bàn chân",relation:"gồm",target:"quan sát hằng ngày",document:"foot_care",evidence:"Người có tiểu đường nên quan sát bàn chân mỗi ngày, kể cả giữa các ngón chân, để sớm nhận ra vết cắt, chỗ đỏ, sưng hoặc phồng rộp. Có thể dùng gương hoặc nhờ người hỗ trợ nếu khó nhìn. Hãy trao đổi với cơ sở y tế khi phát hiện tổn thương; kiểm tra bàn chân trong các lần khám.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",source_page:null,source_file:null,source_sha256:null},
{source:"Tiểu đường",relation:"cần chú ý",target:"chăm sóc bàn chân",document:"foot_care",evidence:"Người có tiểu đường nên quan sát bàn chân mỗi ngày, kể cả giữa các ngón chân, để sớm nhận ra vết cắt, chỗ đỏ, sưng hoặc phồng rộp. Có thể dùng gương hoặc nhờ người hỗ trợ nếu khó nhìn. Hãy trao đổi với cơ sở y tế khi phát hiện tổn thương; kiểm tra bàn chân trong các lần khám.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-problems/foot-problems",source_page:null,source_file:null,source_sha256:null},
{source:"Nước ép",relation:"có thể làm tăng nhanh",target:"đường huyết",document:"fruit",evidence:"Ưu tiên trái cây nguyên quả theo khẩu phần, nước lọc hoặc đồ uống không thêm đường. Nước ép và đồ uống có đường có thể làm đường huyết tăng nhanh. Không có một loại trái cây phù hợp vô hạn cho mọi người.",source_url:"https://www.cdc.gov/diabetes/healthy-eating/diabetes-meal-planning.html",source_page:null,source_file:null,source_sha256:null},
{source:"Nước ép",relation:"có thể làm đường huyết tăng nhanh hơn",target:"trái cây nguyên quả",document:"fruit_whole",evidence:"Trái cây có carbohydrate; không cần tự cấm toàn bộ trái cây, nhưng cần chú ý lượng và tính vào kế hoạch ăn. CDC nêu nước ép làm đường huyết tăng nhanh hơn trái cây nguyên quả. Ưu tiên quả nguyên thay cho nước ép và đồ uống thêm đường. Không kết luận một loại quả an toàn để ăn không giới hạn chỉ vì ít ngọt.",source_url:"https://www.cdc.gov/diabetes/healthy-eating/diabetes-meal-planning.html",source_page:null,source_file:null,source_sha256:null},
{source:"Trái cây",relation:"cung cấp",target:"carbohydrate",document:"fruit_whole",evidence:"Trái cây có carbohydrate; không cần tự cấm toàn bộ trái cây, nhưng cần chú ý lượng và tính vào kế hoạch ăn. CDC nêu nước ép làm đường huyết tăng nhanh hơn trái cây nguyên quả. Ưu tiên quả nguyên thay cho nước ép và đồ uống thêm đường. Không kết luận một loại quả an toàn để ăn không giới hạn chỉ vì ít ngọt.",source_url:"https://www.cdc.gov/diabetes/healthy-eating/diabetes-meal-planning.html",source_page:null,source_file:null,source_sha256:null},
{source:"Nhật ký đường huyết",relation:"ghi",target:"ngày giờ / số đo / đơn vị / bữa ăn",document:"glucose_log",evidence:"Một bảng ghi đơn giản có các cột: ngày giờ; tên phép đo; kết quả và đơn vị; trước hay sau bữa ăn; thuốc đã dùng; hoạt động; triệu chứng. Giữ nguyên số đo gốc, không đổi điểm nghiên cứu thành đường huyết. Tần suất đo và mục tiêu cần thống nhất với nhóm chăm sóc; ghi chép giúp nhìn xu hướng và trao đổi khi tái khám.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Nhật ký đường huyết",relation:"hỗ trợ",target:"trao đổi khi tái khám",document:"glucose_log",evidence:"Một bảng ghi đơn giản có các cột: ngày giờ; tên phép đo; kết quả và đơn vị; trước hay sau bữa ăn; thuốc đã dùng; hoạt động; triệu chứng. Giữ nguyên số đo gốc, không đổi điểm nghiên cứu thành đường huyết. Tần suất đo và mục tiêu cần thống nhất với nhóm chăm sóc; ghi chép giúp nhìn xu hướng và trao đổi khi tái khám.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"HDL",relation:"cần đối chiếu",target:"giới và bảng mỡ máu",document:"hdl",evidence:"HDL tham gia đưa cholesterol về gan. Ngưỡng tham chiếu thấp khác nhau theo giới; HDL không đủ để kết luận toàn bộ nguy cơ tim mạch. Gửi số đo kèm mg/dL hoặc mmol/L để được giải thích.",source_url:"https://medlineplus.gov/cholesterollevelswhatyouneedtoknow.html",source_page:null,source_file:null,source_sha256:null},
{source:"Bắt đầu insulin",relation:"không tự đồng nghĩa với",target:"giai đoạn cuối",document:"insulin_info",evidence:"Insulin giúp kiểm soát đường huyết. Type 1 cần insulin vì cơ thể không tự tạo đủ; một số người type 2 cũng cần insulin hoặc thuốc khác, có thể ở từng giai đoạn. Bắt đầu insulin không tự đồng nghĩa với giai đoạn cuối. Kế hoạch điều trị được chọn theo nhu cầu từng người, không tự ngừng insulin.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/insulin-medicines-treatments",source_page:null,source_file:null,source_sha256:null},
{source:"Tiểu đường type 1",relation:"cần",target:"insulin",document:"insulin_info",evidence:"Insulin giúp kiểm soát đường huyết. Type 1 cần insulin vì cơ thể không tự tạo đủ; một số người type 2 cũng cần insulin hoặc thuốc khác, có thể ở từng giai đoạn. Bắt đầu insulin không tự đồng nghĩa với giai đoạn cuối. Kế hoạch điều trị được chọn theo nhu cầu từng người, không tự ngừng insulin.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/insulin-medicines-treatments",source_page:null,source_file:null,source_sha256:null},
{source:"Tiểu đường type 2",relation:"có thể cần",target:"insulin",document:"insulin_info",evidence:"Insulin giúp kiểm soát đường huyết. Type 1 cần insulin vì cơ thể không tự tạo đủ; một số người type 2 cũng cần insulin hoặc thuốc khác, có thể ở từng giai đoạn. Bắt đầu insulin không tự đồng nghĩa với giai đoạn cuối. Kế hoạch điều trị được chọn theo nhu cầu từng người, không tự ngừng insulin.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/insulin-medicines-treatments",source_page:null,source_file:null,source_sha256:null},
{source:"Theo dõi thận",relation:"dùng",target:"UACR",document:"kidney_checks",evidence:"UACR (tỷ số albumin/creatinine trong nước tiểu) và eGFR (mức lọc cầu thận ước tính) là hai chỉ số thường dùng để đánh giá tổn thương thận. Người có tiểu đường nên trao đổi với bác sĩ về thời điểm kiểm tra và ý nghĩa kết quả; một chỉ số đơn lẻ không đủ kết luận tình trạng thận.",source_url:"https://www.niddk.nih.gov/health-information/professionals/advanced-search/quick-reference-uacr-gfr",source_page:null,source_file:null,source_sha256:null},
{source:"Theo dõi thận",relation:"dùng",target:"eGFR",document:"kidney_checks",evidence:"UACR (tỷ số albumin/creatinine trong nước tiểu) và eGFR (mức lọc cầu thận ước tính) là hai chỉ số thường dùng để đánh giá tổn thương thận. Người có tiểu đường nên trao đổi với bác sĩ về thời điểm kiểm tra và ý nghĩa kết quả; một chỉ số đơn lẻ không đủ kết luận tình trạng thận.",source_url:"https://www.niddk.nih.gov/health-information/professionals/advanced-search/quick-reference-uacr-gfr",source_page:null,source_file:null,source_sha256:null},
{source:"LDL",relation:"liên quan",target:"nguy cơ xơ vữa",document:"ldl",evidence:"LDL liên quan đến tích tụ cholesterol trong thành mạch. Người có bệnh tim mạch hoặc nguy cơ cao có thể cần mục tiêu LDL thấp hơn mức tham chiếu chung; không tự dùng hoặc đổi liều thuốc theo chatbot.",source_url:"https://medlineplus.gov/cholesterollevelswhatyouneedtoknow.html",source_page:null,source_file:null,source_sha256:null},
{source:"Mục tiêu LDL",relation:"cần",target:"đánh giá cá nhân",document:"ldl",evidence:"LDL liên quan đến tích tụ cholesterol trong thành mạch. Người có bệnh tim mạch hoặc nguy cơ cao có thể cần mục tiêu LDL thấp hơn mức tham chiếu chung; không tự dùng hoặc đổi liều thuốc theo chatbot.",source_url:"https://medlineplus.gov/cholesterollevelswhatyouneedtoknow.html",source_page:null,source_file:null,source_sha256:null},
{source:"Bảng mỡ máu",relation:"gồm",target:"toàn phần / LDL / HDL / triglyceride",document:"lipids",evidence:"Bảng mỡ máu gồm cholesterol toàn phần, LDL, HDL và triglyceride. Cần xác định đúng loại xét nghiệm và đơn vị; không kết luận nguy cơ tim mạch chỉ từ một con số. Mục tiêu LDL còn phụ thuộc bệnh nền và nguy cơ cá nhân.",source_url:"https://medlineplus.gov/cholesterollevelswhatyouneedtoknow.html",source_page:null,source_file:null,source_sha256:null},
{source:"Mục tiêu LDL",relation:"phụ thuộc",target:"nguy cơ cá nhân",document:"lipids",evidence:"Bảng mỡ máu gồm cholesterol toàn phần, LDL, HDL và triglyceride. Cần xác định đúng loại xét nghiệm và đơn vị; không kết luận nguy cơ tim mạch chỉ từ một con số. Mục tiêu LDL còn phụ thuộc bệnh nền và nguy cơ cá nhân.",source_url:"https://medlineplus.gov/cholesterollevelswhatyouneedtoknow.html",source_page:null,source_file:null,source_sha256:null},
{source:"Glucose dưới 70",relation:"gợi ý",target:"hạ đường huyết",document:"low",evidence:"Dưới 70 mg/dL được coi là thấp. Người lớn còn tỉnh và nuốt được có thể áp dụng quy tắc 15-15: 15 g carbohydrate nhanh, đo lại sau 15 phút và lặp lại nếu còn thấp. Không cho ăn uống khi bất tỉnh hoặc không nuốt được; cần trợ giúp y tế khẩn cấp.",source_url:"https://www.cdc.gov/diabetes/treatment/treatment-low-blood-sugar-hypoglycemia.html",source_page:null,source_file:null,source_sha256:null},
{source:"Không nuốt được",relation:"không được",target:"cho ăn uống",document:"low",evidence:"Dưới 70 mg/dL được coi là thấp. Người lớn còn tỉnh và nuốt được có thể áp dụng quy tắc 15-15: 15 g carbohydrate nhanh, đo lại sau 15 phút và lặp lại nếu còn thấp. Không cho ăn uống khi bất tỉnh hoặc không nuốt được; cần trợ giúp y tế khẩn cấp.",source_url:"https://www.cdc.gov/diabetes/treatment/treatment-low-blood-sugar-hypoglycemia.html",source_page:null,source_file:null,source_sha256:null},
{source:"Đĩa ăn cân bằng",relation:"dành một phần tư cho",target:"đạm",document:"meal_example",evidence:"Bạn có thể thử một bữa cơm theo cách chia đĩa:\n- Rau luộc hoặc salad không ngọt, không nhiều tinh bột: nửa đĩa.\n- Cá, thịt nạc, trứng hoặc đậu phụ: một phần tư đĩa.\n- Cơm hoặc thực phẩm chứa tinh bột: một phần tư còn lại.\n- Đồ uống: nước lọc.\nĐây là ví dụ phân nhóm thực phẩm; phần ăn thực tế cần phù hợp nhu cầu và thuốc của bạn. Không tự ấn định số bát cơm hay số gram khi chưa biết nhu cầu.",source_url:"https://www.cdc.gov/diabetes/healthy-eating/diabetes-meal-planning.html",source_page:null,source_file:null,source_sha256:null},
{source:"Đĩa ăn cân bằng",relation:"dành nửa đĩa cho",target:"rau không nhiều tinh bột",document:"meal_example",evidence:"Bạn có thể thử một bữa cơm theo cách chia đĩa:\n- Rau luộc hoặc salad không ngọt, không nhiều tinh bột: nửa đĩa.\n- Cá, thịt nạc, trứng hoặc đậu phụ: một phần tư đĩa.\n- Cơm hoặc thực phẩm chứa tinh bột: một phần tư còn lại.\n- Đồ uống: nước lọc.\nĐây là ví dụ phân nhóm thực phẩm; phần ăn thực tế cần phù hợp nhu cầu và thuốc của bạn. Không tự ấn định số bát cơm hay số gram khi chưa biết nhu cầu.",source_url:"https://www.cdc.gov/diabetes/healthy-eating/diabetes-meal-planning.html",source_page:null,source_file:null,source_sha256:null},
{source:"Đĩa ăn cân bằng",relation:"dành phần tư còn lại cho",target:"thực phẩm chứa tinh bột",document:"meal_example",evidence:"Bạn có thể thử một bữa cơm theo cách chia đĩa:\n- Rau luộc hoặc salad không ngọt, không nhiều tinh bột: nửa đĩa.\n- Cá, thịt nạc, trứng hoặc đậu phụ: một phần tư đĩa.\n- Cơm hoặc thực phẩm chứa tinh bột: một phần tư còn lại.\n- Đồ uống: nước lọc.\nĐây là ví dụ phân nhóm thực phẩm; phần ăn thực tế cần phù hợp nhu cầu và thuốc của bạn. Không tự ấn định số bát cơm hay số gram khi chưa biết nhu cầu.",source_url:"https://www.cdc.gov/diabetes/healthy-eating/diabetes-meal-planning.html",source_page:null,source_file:null,source_sha256:null},
{source:"Bỏ hoặc trì hoãn bữa khi dùng insulin",relation:"có thể gây",target:"hạ đường huyết",document:"meal_timing",evidence:"Giờ ăn và bữa phụ phụ thuộc thuốc, hoạt động và lịch làm việc. Một số thuốc, gồm insulin, có thể gây hạ đường huyết khi bỏ hoặc trì hoãn bữa ăn. Không tự nhịn ăn để xử lý một chỉ số cao. Có thể mang lịch làm việc và giờ dùng thuốc trao đổi với nhóm chăm sóc để sắp xếp bữa phù hợp.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Giờ ăn",relation:"phụ thuộc",target:"thuốc / hoạt động / lịch làm việc",document:"meal_timing",evidence:"Giờ ăn và bữa phụ phụ thuộc thuốc, hoạt động và lịch làm việc. Một số thuốc, gồm insulin, có thể gây hạ đường huyết khi bỏ hoặc trì hoãn bữa ăn. Không tự nhịn ăn để xử lý một chỉ số cao. Có thể mang lịch làm việc và giờ dùng thuốc trao đổi với nhóm chăm sóc để sắp xếp bữa phù hợp.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"bp",relation:"biểu diễn",target:"huyết áp trung bình",document:"meanpressure",evidence:"Trường bp của bộ diabetes là huyết áp trung bình, không phải số trên hoặc số dưới của máy đo. Không áp bảng phân loại tâm thu/tâm trương lên một giá trị bp. Nếu muốn đánh giá huyết áp, gửi cặp số đo gốc.",source_url:"https://scikit-learn.org/stable/modules/generated/sklearn.datasets.load_diabetes.html",source_page:null,source_file:null,source_sha256:null},
{source:"bp",relation:"không đồng nhất với",target:"huyết áp tâm thu",document:"meanpressure",evidence:"Trường bp của bộ diabetes là huyết áp trung bình, không phải số trên hoặc số dưới của máy đo. Không áp bảng phân loại tâm thu/tâm trương lên một giá trị bp. Nếu muốn đánh giá huyết áp, gửi cặp số đo gốc.",source_url:"https://scikit-learn.org/stable/modules/generated/sklearn.datasets.load_diabetes.html",source_page:null,source_file:null,source_sha256:null},
{source:"Liều thuốc",relation:"cần được chỉ định bởi",target:"nhân viên y tế",document:"medicine",evidence:"Loại thuốc và liều phụ thuộc chẩn đoán, chức năng thận, thuốc khác và nguy cơ hạ đường huyết. Mình không thể quyết định liều phù hợp cho bạn. Hãy ghi tên thuốc, liều hiện tại, thời điểm uống và số đo để trao đổi với bác sĩ; không tự tăng, giảm hoặc ngừng thuốc.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Metformin",relation:"giúp cải thiện",target:"sử dụng insulin",document:"metformin_info",evidence:"Metformin là thuốc uống thường dùng trong điều trị type 2. Thuốc giúp gan tạo ít glucose hơn và giúp cơ thể sử dụng insulin tốt hơn. Việc lựa chọn thuốc còn phụ thuộc tình trạng bệnh và các yếu tố cá nhân; tên thuốc riêng lẻ không cho biết mức độ bệnh. Bác sĩ quyết định có phù hợp hay không.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/insulin-medicines-treatments",source_page:null,source_file:null,source_sha256:null},
{source:"Metformin",relation:"giúp giảm",target:"glucose do gan tạo ra",document:"metformin_info",evidence:"Metformin là thuốc uống thường dùng trong điều trị type 2. Thuốc giúp gan tạo ít glucose hơn và giúp cơ thể sử dụng insulin tốt hơn. Việc lựa chọn thuốc còn phụ thuộc tình trạng bệnh và các yếu tố cá nhân; tên thuốc riêng lẻ không cho biết mức độ bệnh. Bác sĩ quyết định có phù hợp hay không.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/insulin-medicines-treatments",source_page:null,source_file:null,source_sha256:null},
{source:"Cách xử lý quên thuốc",relation:"cần hỏi",target:"bác sĩ hoặc dược sĩ",document:"missed_medicine",evidence:"Khi được kê thuốc, nên hỏi rõ giờ dùng, cách xử lý khi quên liều và tác dụng phụ cần báo. Nếu đã quên liều hoặc có khó chịu, cần tên thuốc, dạng thuốc, liều kê và thời điểm để hỏi bác sĩ hoặc dược sĩ. Chatbot không tự tính liều bù, đổi thuốc hoặc khuyên uống gấp đôi.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/insulin-medicines-treatments",source_page:null,source_file:null,source_sha256:null},
{source:"Quên liều thuốc",relation:"cần đối chiếu",target:"tên thuốc / liều kê / thời điểm",document:"missed_medicine",evidence:"Khi được kê thuốc, nên hỏi rõ giờ dùng, cách xử lý khi quên liều và tác dụng phụ cần báo. Nếu đã quên liều hoặc có khó chịu, cần tên thuốc, dạng thuốc, liều kê và thời điểm để hỏi bác sĩ hoặc dược sĩ. Chatbot không tự tính liều bù, đổi thuốc hoặc khuyên uống gấp đôi.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/insulin-medicines-treatments",source_page:null,source_file:null,source_sha256:null},
{source:"Mô hình diabetes",relation:"dự báo",target:"điểm tiến triển nghiên cứu",document:"model",evidence:"Mô hình học trên 442 người đã mắc tiểu đường để ước lượng điểm tiến triển sau một năm. Điểm này không phải glucose, HbA1c hay phần trăm nguy cơ mắc bệnh. Khoảng dự báo và sai số ngoài mẫu giúp nhìn thấy mức bất định.",source_url:"https://scikit-learn.org/stable/modules/generated/sklearn.datasets.load_diabetes.html",source_page:null,source_file:null,source_sha256:null},
{source:"Điểm tiến triển",relation:"không phải",target:"xác suất mắc bệnh",document:"model",evidence:"Mô hình học trên 442 người đã mắc tiểu đường để ước lượng điểm tiến triển sau một năm. Điểm này không phải glucose, HbA1c hay phần trăm nguy cơ mắc bệnh. Khoảng dự báo và sai số ngoài mẫu giúp nhìn thấy mức bất định.",source_url:"https://scikit-learn.org/stable/modules/generated/sklearn.datasets.load_diabetes.html",source_page:null,source_file:null,source_sha256:null},
{source:"Mục tiêu điều trị",relation:"phụ thuộc",target:"từng người",document:"monitor",evidence:"Ghi thời điểm đo, kết quả, bữa ăn, vận động, thuốc và triệu chứng. Tần suất đo và mục tiêu cần cá nhân hóa, đặc biệt nếu đang dùng insulin. Mục tiêu điều trị của người đã mắc tiểu đường khác bảng ngưỡng dùng để chẩn đoán ban đầu.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Nhật ký",relation:"hỗ trợ",target:"tái khám",document:"monitor",evidence:"Ghi thời điểm đo, kết quả, bữa ăn, vận động, thuốc và triệu chứng. Tần suất đo và mục tiêu cần cá nhân hóa, đặc biệt nếu đang dùng insulin. Mục tiêu điều trị của người đã mắc tiểu đường khác bảng ngưỡng dùng để chẩn đoán ban đầu.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Sau chẩn đoán",relation:"cần làm rõ",target:"loại bệnh / mục tiêu / thuốc",document:"new_diagnosis",evidence:"Sau khi được chẩn đoán, có thể làm từng bước: hiểu loại bệnh và mục tiêu theo dõi; làm rõ cách dùng thuốc nếu có đơn; học cách đo và ghi kết quả; bàn kế hoạch ăn uống, hoạt động và lịch tái khám. Không cần thay đổi mọi thói quen cùng lúc. Ưu tiên một việc có thể thực hiện hôm nay, rồi xem lại cùng nhóm chăm sóc.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Sau chẩn đoán",relation:"cần lên kế hoạch",target:"đo / ghi chép / ăn uống / tái khám",document:"new_diagnosis",evidence:"Sau khi được chẩn đoán, có thể làm từng bước: hiểu loại bệnh và mục tiêu theo dõi; làm rõ cách dùng thuốc nếu có đơn; học cách đo và ghi kết quả; bàn kế hoạch ăn uống, hoạt động và lịch tái khám. Không cần thay đổi mọi thói quen cùng lúc. Ưu tiên một việc có thể thực hiện hôm nay, rồi xem lại cùng nhóm chăm sóc.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/managing-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Tiểu đường",relation:"không phải",target:"bệnh truyền nhiễm",document:"not_contagious",evidence:"Tiểu đường không phải bệnh truyền nhiễm và không lây từ người này sang người khác như cảm cúm. Ăn chung hoặc tiếp xúc sinh hoạt không làm lây bệnh tiểu đường. Nguy cơ type 2 có liên quan đến nhiều yếu tố, trong đó có tiền sử gia đình và sinh hoạt; điều này khác với lây nhiễm.",source_url:"https://diabetes.org/about-diabetes/diabetes-myths",source_page:null,source_file:null,source_sha256:null},
{source:"Ăn chung hoặc tiếp xúc",relation:"không làm lây",target:"tiểu đường",document:"not_contagious",evidence:"Tiểu đường không phải bệnh truyền nhiễm và không lây từ người này sang người khác như cảm cúm. Ăn chung hoặc tiếp xúc sinh hoạt không làm lây bệnh tiểu đường. Nguy cơ type 2 có liên quan đến nhiều yếu tố, trong đó có tiền sử gia đình và sinh hoạt; điều này khác với lây nhiễm.",source_url:"https://diabetes.org/about-diabetes/diabetes-myths",source_page:null,source_file:null,source_sha256:null},
{source:"Insulin",relation:"giúp điều hòa",target:"đường huyết",document:"overview",evidence:"Tiểu đường (đái tháo đường) là bệnh mạn tính xảy ra khi cơ thể không tạo đủ insulin hoặc sử dụng insulin không hiệu quả, khiến đường huyết tăng. Insulin là hormone giúp điều hòa đường trong máu. Có nhiều loại bệnh; xét nghiệm và thăm khám giúp xác định loại và kế hoạch theo dõi. Điều trị và theo dõi phù hợp giúp giảm nguy cơ biến chứng.",source_url:"https://www.who.int/news-room/fact-sheets/detail/diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Tiểu đường",relation:"liên quan đến",target:"thiếu hoặc sử dụng insulin kém hiệu quả",document:"overview",evidence:"Tiểu đường (đái tháo đường) là bệnh mạn tính xảy ra khi cơ thể không tạo đủ insulin hoặc sử dụng insulin không hiệu quả, khiến đường huyết tăng. Insulin là hormone giúp điều hòa đường trong máu. Có nhiều loại bệnh; xét nghiệm và thăm khám giúp xác định loại và kế hoạch theo dõi. Điều trị và theo dõi phù hợp giúp giảm nguy cơ biến chứng.",source_url:"https://www.who.int/news-room/fact-sheets/detail/diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Vận động",relation:"có ví dụ",target:"đi bộ",document:"pdf_activity_options",evidence:"Tài liệu NIDDK liệt kê đi bộ, đạp xe và làm vườn trong các ví dụ vận động. Chọn loại hoạt động theo khả năng và trao đổi kế hoạch với nhóm điều trị khi có bệnh đi kèm hoặc lo ngại an toàn. Danh sách này không tự xác định cường độ hay thời lượng phù hợp cho bạn.",source_url:"https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf",source_page:34,source_file:"data/source_documents/niddk_guiding_principles.pdf",source_sha256:"40a7da28c6889a262f4fb20e6ed648de3e7d55c0aab337491721bd232e7c2aa9"},
{source:"Vận động",relation:"cần phù hợp",target:"khả năng cá nhân",document:"pdf_activity_options",evidence:"Tài liệu NIDDK liệt kê đi bộ, đạp xe và làm vườn trong các ví dụ vận động. Chọn loại hoạt động theo khả năng và trao đổi kế hoạch với nhóm điều trị khi có bệnh đi kèm hoặc lo ngại an toàn. Danh sách này không tự xác định cường độ hay thời lượng phù hợp cho bạn.",source_url:"https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf",source_page:34,source_file:"data/source_documents/niddk_guiding_principles.pdf",source_sha256:"40a7da28c6889a262f4fb20e6ed648de3e7d55c0aab337491721bd232e7c2aa9"},
{source:"Bữa ăn",relation:"có thể chọn",target:"rau và đậu",document:"pdf_food_choices",evidence:"Các lựa chọn được NIDDK nêu gồm rau, trái cây, đậu và ngũ cốc nguyên hạt; đạm từ cá, thịt nạc, gia cầm bỏ da, trứng và sản phẩm đậu nành. Hạn chế đường thêm và đồ uống có đường, chọn nước lọc. Tỷ lệ và khẩu phần cần điều chỉnh cùng nhóm điều trị theo hoàn cảnh cá nhân.",source_url:"https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf",source_page:32,source_file:"data/source_documents/niddk_guiding_principles.pdf",source_sha256:"40a7da28c6889a262f4fb20e6ed648de3e7d55c0aab337491721bd232e7c2aa9"},
{source:"Nguồn đạm",relation:"có thể chọn",target:"cá hoặc đậu nành",document:"pdf_food_choices",evidence:"Các lựa chọn được NIDDK nêu gồm rau, trái cây, đậu và ngũ cốc nguyên hạt; đạm từ cá, thịt nạc, gia cầm bỏ da, trứng và sản phẩm đậu nành. Hạn chế đường thêm và đồ uống có đường, chọn nước lọc. Tỷ lệ và khẩu phần cần điều chỉnh cùng nhóm điều trị theo hoàn cảnh cá nhân.",source_url:"https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf",source_page:32,source_file:"data/source_documents/niddk_guiding_principles.pdf",source_sha256:"40a7da28c6889a262f4fb20e6ed648de3e7d55c0aab337491721bd232e7c2aa9"},
{source:"Kế hoạch ăn",relation:"cần xem xét",target:"bệnh đi kèm",document:"pdf_nutrition",evidence:"Kế hoạch ăn cần xét tình trạng sức khỏe, bệnh đi kèm, sở thích và nhu cầu dinh dưỡng. NIDDK khuyến khích đánh giá, theo dõi và điều chỉnh kế hoạch cùng chuyên gia dinh dưỡng. Một nhãn phân loại hoặc điểm hồi quy không đủ để tính khẩu phần riêng cho một người.",source_url:"https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf",source_page:31,source_file:"data/source_documents/niddk_guiding_principles.pdf",source_sha256:"40a7da28c6889a262f4fb20e6ed648de3e7d55c0aab337491721bd232e7c2aa9"},
{source:"Kế hoạch ăn",relation:"phụ thuộc",target:"nhu cầu cá nhân",document:"pdf_nutrition",evidence:"Kế hoạch ăn cần xét tình trạng sức khỏe, bệnh đi kèm, sở thích và nhu cầu dinh dưỡng. NIDDK khuyến khích đánh giá, theo dõi và điều chỉnh kế hoạch cùng chuyên gia dinh dưỡng. Một nhãn phân loại hoặc điểm hồi quy không đủ để tính khẩu phần riêng cho một người.",source_url:"https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf",source_page:31,source_file:"data/source_documents/niddk_guiding_principles.pdf",source_sha256:"40a7da28c6889a262f4fb20e6ed648de3e7d55c0aab337491721bd232e7c2aa9"},
{source:"Insulin",relation:"cần trao đổi về",target:"carbohydrate",document:"pdf_portions",evidence:"Trong tài liệu NIDDK, người dùng insulin cần trao đổi về theo dõi lượng carbohydrate; kiểm soát khẩu phần cũng là một công cụ quan trọng. Ghi món, lượng đã ăn và thời điểm đo giúp bạn trao đổi cụ thể hơn khi tái khám. Đây không phải chỉ dẫn tự tính hoặc đổi liều insulin.",source_url:"https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf",source_page:32,source_file:"data/source_documents/niddk_guiding_principles.pdf",source_sha256:"40a7da28c6889a262f4fb20e6ed648de3e7d55c0aab337491721bd232e7c2aa9"},
{source:"Theo dõi bữa ăn",relation:"ghi lại",target:"khẩu phần",document:"pdf_portions",evidence:"Trong tài liệu NIDDK, người dùng insulin cần trao đổi về theo dõi lượng carbohydrate; kiểm soát khẩu phần cũng là một công cụ quan trọng. Ghi món, lượng đã ăn và thời điểm đo giúp bạn trao đổi cụ thể hơn khi tái khám. Đây không phải chỉ dẫn tự tính hoặc đổi liều insulin.",source_url:"https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf",source_page:32,source_file:"data/source_documents/niddk_guiding_principles.pdf",source_sha256:"40a7da28c6889a262f4fb20e6ed648de3e7d55c0aab337491721bd232e7c2aa9"},
{source:"Tự chăm sóc",relation:"bao gồm",target:"theo dõi sức khỏe",document:"pdf_self_management",evidence:"Tài liệu NIDDK xem tự chăm sóc là quá trình liên tục: ăn uống, vận động, dùng thuốc theo hướng dẫn, theo dõi dữ liệu sức khỏe và trao đổi với nhóm điều trị. Bạn có thể ghi số đo, bữa ăn, thuốc đang dùng và điều còn vướng để mang đi khám; không tự đổi thuốc theo kết quả mô hình nghiên cứu.",source_url:"https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf",source_page:27,source_file:"data/source_documents/niddk_guiding_principles.pdf",source_sha256:"40a7da28c6889a262f4fb20e6ed648de3e7d55c0aab337491721bd232e7c2aa9"},
{source:"Tự chăm sóc",relation:"cần phối hợp",target:"nhóm điều trị",document:"pdf_self_management",evidence:"Tài liệu NIDDK xem tự chăm sóc là quá trình liên tục: ăn uống, vận động, dùng thuốc theo hướng dẫn, theo dõi dữ liệu sức khỏe và trao đổi với nhóm điều trị. Bạn có thể ghi số đo, bữa ăn, thuốc đang dùng và điều còn vướng để mang đi khám; không tự đổi thuốc theo kết quả mô hình nghiên cứu.",source_url:"https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf",source_page:27,source_file:"data/source_documents/niddk_guiding_principles.pdf",source_sha256:"40a7da28c6889a262f4fb20e6ed648de3e7d55c0aab337491721bd232e7c2aa9"},
{source:"Mục tiêu tự chăm sóc",relation:"cần phù hợp",target:"nhu cầu cá nhân",document:"pdf_shared_goals",evidence:"NIDDK đề cập việc đặt mục tiêu hành vi và giải quyết trở ngại theo nhu cầu từng người. Có thể bắt đầu bằng một thay đổi bạn thấy làm được, rồi trao đổi điều chưa thuận lợi với nhóm chăm sóc. Người thân có thể tham gia để hỗ trợ duy trì thói quen.",source_url:"https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf",source_page:28,source_file:"data/source_documents/niddk_guiding_principles.pdf",source_sha256:"40a7da28c6889a262f4fb20e6ed648de3e7d55c0aab337491721bd232e7c2aa9"},
{source:"Người thân",relation:"hỗ trợ",target:"thói quen tự chăm sóc",document:"pdf_shared_goals",evidence:"NIDDK đề cập việc đặt mục tiêu hành vi và giải quyết trở ngại theo nhu cầu từng người. Có thể bắt đầu bằng một thay đổi bạn thấy làm được, rồi trao đổi điều chưa thuận lợi với nhóm chăm sóc. Người thân có thể tham gia để hỗ trợ duy trì thói quen.",source_url:"https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf",source_page:28,source_file:"data/source_documents/niddk_guiding_principles.pdf",source_sha256:"40a7da28c6889a262f4fb20e6ed648de3e7d55c0aab337491721bd232e7c2aa9"},
{source:"Bữa ăn",relation:"chia theo",target:"phương pháp chiếc đĩa",document:"plate",evidence:"Gợi ý minh họa: nửa đĩa rau luộc hoặc salad không ngọt; một phần tư cá, thịt nạc hoặc đậu phụ; phần tư còn lại là cơm hoặc thực phẩm chứa tinh bột. Chọn nước lọc. Điều chỉnh khẩu phần theo nhu cầu, thuốc và mục tiêu cá nhân.",source_url:"https://www.cdc.gov/diabetes/healthy-eating/diabetes-meal-planning.html",source_page:null,source_file:null,source_sha256:null},
{source:"Chiếc đĩa",relation:"ưu tiên",target:"rau không tinh bột",document:"plate",evidence:"Gợi ý minh họa: nửa đĩa rau luộc hoặc salad không ngọt; một phần tư cá, thịt nạc hoặc đậu phụ; phần tư còn lại là cơm hoặc thực phẩm chứa tinh bột. Chọn nước lọc. Điều chỉnh khẩu phần theo nhu cầu, thuốc và mục tiêu cá nhân.",source_url:"https://www.cdc.gov/diabetes/healthy-eating/diabetes-meal-planning.html",source_page:null,source_file:null,source_sha256:null},
{source:"Theo dõi và sinh hoạt phù hợp",relation:"có thể trì hoãn",target:"tiểu đường type 2",document:"prediabetes",evidence:"Tiền đái tháo đường nghĩa là đường huyết cao hơn bình thường nhưng chưa đến mức chẩn đoán type 2. Nguy cơ phát triển type 2 cao hơn; thay đổi sinh hoạt và theo dõi với nhân viên y tế có thể giúp phòng hoặc trì hoãn bệnh. Không phải ai ở giai đoạn này cũng chắc chắn tiến triển thành tiểu đường.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Tiền đái tháo đường",relation:"làm tăng nguy cơ",target:"tiểu đường type 2",document:"prediabetes",evidence:"Tiền đái tháo đường nghĩa là đường huyết cao hơn bình thường nhưng chưa đến mức chẩn đoán type 2. Nguy cơ phát triển type 2 cao hơn; thay đổi sinh hoạt và theo dõi với nhân viên y tế có thể giúp phòng hoặc trì hoãn bệnh. Không phải ai ở giai đoạn này cũng chắc chắn tiến triển thành tiểu đường.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Tiểu đường thai kỳ",relation:"cần",target:"theo dõi theo bối cảnh sản khoa",document:"pregnancy_diabetes",evidence:"Tiểu đường thai kỳ xuất hiện trong thời gian mang thai và thường hết sau sinh, nhưng làm tăng nguy cơ type 2 về sau. Chỉ số và kế hoạch theo dõi trong thai kỳ cần trao đổi với nhóm chăm sóc sản khoa. Không áp ngưỡng và kế hoạch của người lớn không mang thai cho thai phụ.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Tiểu đường thai kỳ",relation:"xuất hiện trong",target:"thai kỳ",document:"pregnancy_diabetes",evidence:"Tiểu đường thai kỳ xuất hiện trong thời gian mang thai và thường hết sau sinh, nhưng làm tăng nguy cơ type 2 về sau. Chỉ số và kế hoạch theo dõi trong thai kỳ cần trao đổi với nhóm chăm sóc sản khoa. Không áp ngưỡng và kế hoạch của người lớn không mang thai cho thai phụ.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Tỷ lệ cholesterol / HDL",relation:"không thay thế",target:"hồ sơ nguy cơ đầy đủ",document:"ratio",evidence:"Tỷ lệ là đại lượng không có đơn vị nồng độ. Không dùng một tỷ lệ riêng lẻ để kết luận nguy cơ hay thay cho LDL và toàn bộ hồ sơ. Đối chiếu với các thành phần mỡ máu gốc.",source_url:"https://medlineplus.gov/cholesterollevelswhatyouneedtoknow.html",source_page:null,source_file:null,source_sha256:null},
{source:"Thuyên giảm type 2",relation:"không đồng nghĩa với",target:"chữa khỏi vĩnh viễn",document:"remission_info",evidence:"Một số người type 2 có thể đạt trạng thái thuyên giảm, tức duy trì đường huyết dưới ngưỡng chẩn đoán trong điều kiện được chuyên môn xác nhận. Thuyên giảm không đồng nghĩa chữa khỏi vĩnh viễn; vẫn cần theo dõi vì đường huyết có thể tăng trở lại. Không tự ngừng thuốc để thử hoặc tự tuyên bố đã hết bệnh chỉ từ một lần đo tốt.",source_url:"https://diabetes.org/newsroom/international-experts-outline-diabetes-remission-diagnosis-criteria",source_page:null,source_file:null,source_sha256:null},
{source:"Thuyên giảm type 2",relation:"vẫn cần",target:"theo dõi đường huyết",document:"remission_info",evidence:"Một số người type 2 có thể đạt trạng thái thuyên giảm, tức duy trì đường huyết dưới ngưỡng chẩn đoán trong điều kiện được chuyên môn xác nhận. Thuyên giảm không đồng nghĩa chữa khỏi vĩnh viễn; vẫn cần theo dõi vì đường huyết có thể tăng trở lại. Không tự ngừng thuốc để thử hoặc tự tuyên bố đã hết bệnh chỉ từ một lần đo tốt.",source_url:"https://diabetes.org/newsroom/international-experts-outline-diabetes-remission-diagnosis-criteria",source_page:null,source_file:null,source_sha256:null},
{source:"Gạo lứt",relation:"vẫn cung cấp",target:"carbohydrate",document:"rice_portion",evidence:"Cơm, ngũ cốc và nhiều thực phẩm khác cung cấp carbohydrate. Có thể dùng phương pháp đĩa ăn để dành phần tinh bột hợp lý, phối hợp rau và đạm; ưu tiên ngũ cốc nguyên hạt khi phù hợp. Gạo lứt vẫn có carbohydrate, nên đổi loại gạo không có nghĩa là ăn không giới hạn. Phần ăn cụ thể cần điều chỉnh theo thuốc, hoạt động và mục tiêu đường huyết.",source_url:"https://www.cdc.gov/diabetes/healthy-eating/diabetes-meal-planning.html",source_page:null,source_file:null,source_sha256:null},
{source:"Phần tinh bột",relation:"cần phù hợp với",target:"thuốc / hoạt động / mục tiêu cá nhân",document:"rice_portion",evidence:"Cơm, ngũ cốc và nhiều thực phẩm khác cung cấp carbohydrate. Có thể dùng phương pháp đĩa ăn để dành phần tinh bột hợp lý, phối hợp rau và đạm; ưu tiên ngũ cốc nguyên hạt khi phù hợp. Gạo lứt vẫn có carbohydrate, nên đổi loại gạo không có nghĩa là ăn không giới hạn. Phần ăn cụ thể cần điều chỉnh theo thuốc, hoạt động và mục tiêu đường huyết.",source_url:"https://www.cdc.gov/diabetes/healthy-eating/diabetes-meal-planning.html",source_page:null,source_file:null,source_sha256:null},
{source:"Ngày ốm",relation:"cần",target:"theo dõi đường huyết",document:"sick_day",evidence:"Khi bị ốm, đường huyết có thể thay đổi dù ăn ít hơn. CDC khuyên trao đổi trước với nhóm chăm sóc về kế hoạch ngày ốm, theo dõi đường huyết thường xuyên hơn theo hướng dẫn và uống nước để tránh mất nước. Nếu khó thở, không giữ được nước uống hoặc có dấu hiệu nặng, cần liên hệ cơ sở y tế khẩn cấp. Không tự chỉnh thuốc theo chatbot.",source_url:"https://www.cdc.gov/diabetes/living-with/managing-sick-days.html",source_page:null,source_file:null,source_sha256:null},
{source:"Ngày ốm",relation:"cần chú ý",target:"mất nước",document:"sick_day",evidence:"Khi bị ốm, đường huyết có thể thay đổi dù ăn ít hơn. CDC khuyên trao đổi trước với nhóm chăm sóc về kế hoạch ngày ốm, theo dõi đường huyết thường xuyên hơn theo hướng dẫn và uống nước để tránh mất nước. Nếu khó thở, không giữ được nước uống hoặc có dấu hiệu nặng, cần liên hệ cơ sở y tế khẩn cấp. Không tự chỉnh thuốc theo chatbot.",source_url:"https://www.cdc.gov/diabetes/living-with/managing-sick-days.html",source_page:null,source_file:null,source_sha256:null},
{source:"Căng thẳng",relation:"có thể ảnh hưởng",target:"đường huyết",document:"stress_glucose",evidence:"Căng thẳng có thể làm đường huyết biến động và gây khó duy trì kế hoạch chăm sóc. Lo âu và hạ đường huyết có thể có biểu hiện giống nhau; nếu có máy, kiểm tra đường huyết giúp đối chiếu thay vì đoán. Ghi lại tình huống và trao đổi với nhóm chăm sóc nếu lặp lại.",source_url:"https://www.cdc.gov/diabetes/living-with/mental-health.html",source_page:null,source_file:null,source_sha256:null},
{source:"Lo âu và hạ đường huyết",relation:"có thể có",target:"biểu hiện giống nhau",document:"stress_glucose",evidence:"Căng thẳng có thể làm đường huyết biến động và gây khó duy trì kế hoạch chăm sóc. Lo âu và hạ đường huyết có thể có biểu hiện giống nhau; nếu có máy, kiểm tra đường huyết giúp đối chiếu thay vì đoán. Ghi lại tình huống và trao đổi với nhóm chăm sóc nếu lặp lại.",source_url:"https://www.cdc.gov/diabetes/living-with/mental-health.html",source_page:null,source_file:null,source_sha256:null},
{source:"Triệu chứng",relation:"cần được xác nhận bằng",target:"khám và xét nghiệm",document:"symptoms",evidence:"Khát nhiều, tiểu nhiều, mệt, mờ mắt hoặc sụt cân không rõ nguyên nhân có thể xuất hiện khi đường huyết cao, nhưng cũng có thể do nguyên nhân khác. Nên khám và làm xét nghiệm; không thể xác nhận tiểu đường chỉ qua triệu chứng.",source_url:"https://www.who.int/news-room/fact-sheets/detail/diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Glucose",relation:"cần có",target:"đơn vị và thời điểm đo",document:"testing",evidence:"Cần biết đơn vị và thời điểm đo. Với xét nghiệm huyết tương lúc đói sau ít nhất 8 giờ không ăn, NIDDK nêu: dưới 100 mg/dL; tiền đái tháo đường 100–125 mg/dL; ngưỡng đái tháo đường từ 126 mg/dL. Không áp bảng này cho số đo sau ăn. Máy đo tại nhà không xác lập chẩn đoán; bác sĩ xem xét xét nghiệm xác nhận.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis",source_page:null,source_file:null,source_sha256:null},
{source:"Triglyceride",relation:"cần có",target:"đơn vị xét nghiệm",document:"triglyceride",evidence:"Triglyceride là một loại mỡ máu. s5/ltg trong bộ diabetes là đặc trưng nghiên cứu có mô tả chưa hoàn toàn rõ; không tự biến s5 thành xét nghiệm triglyceride để phân loại. Hãy gửi giá trị triglyceride gốc và đơn vị trên phiếu.",source_url:"https://scikit-learn.org/stable/modules/generated/sklearn.datasets.load_diabetes.html",source_page:null,source_file:null,source_sha256:null},
{source:"s5 / ltg",relation:"không tự coi là",target:"xét nghiệm triglyceride gốc",document:"triglyceride",evidence:"Triglyceride là một loại mỡ máu. s5/ltg trong bộ diabetes là đặc trưng nghiên cứu có mô tả chưa hoàn toàn rõ; không tự biến s5 thành xét nghiệm triglyceride để phân loại. Hãy gửi giá trị triglyceride gốc và đơn vị trên phiếu.",source_url:"https://scikit-learn.org/stable/modules/generated/sklearn.datasets.load_diabetes.html",source_page:null,source_file:null,source_sha256:null},
{source:"Tiểu đường type 1",relation:"liên quan đến",target:"phá hủy tế bào sản xuất insulin",document:"types_compare",evidence:"Type 1: hệ miễn dịch phá hủy tế bào sản xuất insulin, cơ thể tạo rất ít hoặc không tạo insulin; người bệnh cần insulin để sống. Type 2: cơ thể sử dụng insulin kém hiệu quả và có thể không tạo đủ insulin. Cả hai có thể xuất hiện ở nhiều lứa tuổi; tuổi hoặc cân nặng riêng lẻ không xác định được type. Cần khám và xét nghiệm để phân biệt.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Tiểu đường type 2",relation:"liên quan đến",target:"sử dụng insulin kém hiệu quả",document:"types_compare",evidence:"Type 1: hệ miễn dịch phá hủy tế bào sản xuất insulin, cơ thể tạo rất ít hoặc không tạo insulin; người bệnh cần insulin để sống. Type 2: cơ thể sử dụng insulin kém hiệu quả và có thể không tạo đủ insulin. Cả hai có thể xuất hiện ở nhiều lứa tuổi; tuổi hoặc cân nặng riêng lẻ không xác định được type. Cần khám và xét nghiệm để phân biệt.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/what-is-diabetes",source_page:null,source_file:null,source_sha256:null},
{source:"Rối loạn ý thức",relation:"cần",target:"trợ giúp y tế khẩn cấp",document:"urgent",evidence:"Nếu đang bất tỉnh, co giật, lú lẫn rõ, khó thở hoặc không nuốt được, cần người bên cạnh gọi cấp cứu địa phương hoặc đưa đến cơ sở y tế ngay. Không tự lái xe và không cố cho ăn uống khi khả năng nuốt bị ảnh hưởng.",source_url:"https://www.cdc.gov/diabetes/treatment/treatment-low-blood-sugar-hypoglycemia.html",source_page:null,source_file:null,source_sha256:null},
{source:"Kiêng quá mức",relation:"có thể gây",target:"mất cân bằng dinh dưỡng",document:"vinmec_balanced_eating",evidence:"Vinmec lưu ý kiêng quá mức có thể làm mất cân đối dinh dưỡng. Kế hoạch chăm sóc cần phối hợp ăn uống, vận động, thuốc được kê và tái khám; không chỉ cắt thức ăn.",source_url:"https://www.vinmec.com/vie/bai-viet/che-do-dinh-duong-cho-nguoi-tieu-duong-vi",source_page:null,source_file:"data/source_documents/vinmec_nutrition.excerpts.json",source_sha256:"20b6e27ca9ecdf04e6e8e51c71ef6cefcb9f45e00e053878a77850810e15b492"},
{source:"Chăm sóc bàn chân",relation:"bao gồm",target:"quan sát da và kẽ ngón",document:"vinmec_foot_check",evidence:"Vinmec hướng dẫn quan sát bàn chân thường xuyên, gồm kẽ ngón, vết xước, phồng rộp và thay đổi màu da. Nếu khó nhìn, dùng gương hoặc nhờ người thân hỗ trợ.",source_url:"https://www.vinmec.com/vie/bai-viet/cach-cham-soc-ban-chan-nguoi-benh-tieu-duong-vi",source_page:null,source_file:"data/source_documents/vinmec_feet.excerpts.json",source_sha256:"c947c3c71bed13a9ee8b01c2310f9f2a3fa8e70b0dcdfdc644e8949e02e8660d"},
{source:"Tổn thương bàn chân",relation:"cần được đánh giá tại",target:"cơ sở y tế",document:"vinmec_foot_clinic",evidence:"Khi phát hiện tổn thương da hoặc chai chân, Vinmec khuyến nghị đến cơ sở y tế để được đánh giá. Đoạn này không cung cấp cách tự xử lý vết thương hay chọn thuốc.",source_url:"https://www.vinmec.com/vie/bai-viet/cach-cham-soc-ban-chan-nguoi-benh-tieu-duong-vi",source_page:null,source_file:"data/source_documents/vinmec_feet.excerpts.json",source_sha256:"c947c3c71bed13a9ee8b01c2310f9f2a3fa8e70b0dcdfdc644e8949e02e8660d"},
{source:"Bữa ăn",relation:"có thể chọn",target:"cá hoặc đậu",document:"vinmec_meal_choices",evidence:"Vinmec gợi ý chọn đậu, cá hoặc thịt nạc; rau được chế biến đơn giản. Có thể ưu tiên món hấp hay luộc và giảm đồ chiên nhiều dầu. Đây là lựa chọn chung, khẩu phần cần trao đổi theo nhu cầu riêng.",source_url:"https://www.vinmec.com/vie/bai-viet/che-do-dinh-duong-cho-nguoi-tieu-duong-vi",source_page:null,source_file:"data/source_documents/vinmec_nutrition.excerpts.json",source_sha256:"20b6e27ca9ecdf04e6e8e51c71ef6cefcb9f45e00e053878a77850810e15b492"},
{source:"Chế biến món ăn",relation:"có thể chọn",target:"hấp hoặc luộc",document:"vinmec_meal_choices",evidence:"Vinmec gợi ý chọn đậu, cá hoặc thịt nạc; rau được chế biến đơn giản. Có thể ưu tiên món hấp hay luộc và giảm đồ chiên nhiều dầu. Đây là lựa chọn chung, khẩu phần cần trao đổi theo nhu cầu riêng.",source_url:"https://www.vinmec.com/vie/bai-viet/che-do-dinh-duong-cho-nguoi-tieu-duong-vi",source_page:null,source_file:"data/source_documents/vinmec_nutrition.excerpts.json",source_sha256:"20b6e27ca9ecdf04e6e8e51c71ef6cefcb9f45e00e053878a77850810e15b492"},
{source:"Bỏ hoặc trì hoãn bữa khi dùng insulin",relation:"có thể làm tăng",target:"nguy cơ hạ đường huyết",document:"web_meal_timing",evidence:"NIDDK lưu ý một số thuốc, gồm insulin và sulfonylurea, có thể làm đường huyết xuống quá thấp khi vận động hoặc bỏ, trễ bữa. Nếu sinh hoạt thay đổi, ghi thời điểm ăn, thuốc, số đo và triệu chứng để trao đổi với nhóm điều trị; không tự chỉnh liều.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",source_page:null,source_file:"data/source_documents/niddk_healthy_living.txt",source_sha256:"64a0c86380996083858f7957f1c66fa88bd97e806c6549c45b3b13e91e83b09f"},
{source:"Kế hoạch ăn",relation:"có công cụ",target:"phương pháp đĩa ăn",document:"web_portion_choices",evidence:"Theo NIDDK, bạn không nhất thiết bỏ mọi món mình thích; có thể cần khẩu phần nhỏ hơn hoặc ăn ít thường xuyên hơn. Phương pháp đĩa ăn và theo dõi carbohydrate là hai cách lập kế hoạch cần trao đổi với nhóm chăm sóc. Việc lựa chọn phụ thuộc kế hoạch cá nhân.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",source_page:null,source_file:"data/source_documents/niddk_healthy_living.txt",source_sha256:"64a0c86380996083858f7957f1c66fa88bd97e806c6549c45b3b13e91e83b09f"},
{source:"Món yêu thích",relation:"cần cân nhắc",target:"khẩu phần",document:"web_portion_choices",evidence:"Theo NIDDK, bạn không nhất thiết bỏ mọi món mình thích; có thể cần khẩu phần nhỏ hơn hoặc ăn ít thường xuyên hơn. Phương pháp đĩa ăn và theo dõi carbohydrate là hai cách lập kế hoạch cần trao đổi với nhóm chăm sóc. Việc lựa chọn phụ thuộc kế hoạch cá nhân.",source_url:"https://www.niddk.nih.gov/health-information/diabetes/overview/healthy-living-with-diabetes",source_page:null,source_file:"data/source_documents/niddk_healthy_living.txt",source_sha256:"64a0c86380996083858f7957f1c66fa88bd97e806c6549c45b3b13e91e83b09f"}
] AS row
MERGE (a:Concept {name:row.source}) MERGE (b:Concept {name:row.target})
MERGE (a)-[r:RELATED_TO {label:row.relation,document:row.document}]->(b)
SET r.evidence=row.evidence,r.source_url=row.source_url,
r.source_page=row.source_page,r.source_file=row.source_file,r.source_sha256=row.source_sha256;
